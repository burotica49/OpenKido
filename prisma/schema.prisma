generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model RepoScan {
  id         Int      @id @default(autoincrement())
  owner      String
  repo       String
  branch     String
  scannedAt  DateTime @default(now())

  total      Int
  vulnerable Int
  critical   Int
  high       Int
  medium     Int
  low        Int

  components String

  // "complete" | "partial" : un scan partiel (OSV/GitHub injoignable pour une partie) ne remplace jamais un scan complet.
  status     String   @default("complete")
  note       String?

  @@unique([owner, repo])
  @@index([owner, repo])
}

model RepoQuality {
  id          Int      @id @default(autoincrement())
  owner       String
  repo        String
  checkedAt   DateTime @default(now())
  score       Int      // 0-100

  hasCi       Boolean
  hasTests    Boolean
  hasLint     Boolean
  hasFormat   Boolean
  hasTypes    Boolean
  hasReadme   Boolean
  hasChangelog Boolean
  hasEditorconfig Boolean

  ciFiles     String   // JSON string[]
  testFiles   String   // JSON string[]
  lintFiles   String   // JSON string[]

  defaultBranch String

  @@unique([owner, repo])
}

model ScanHistory {
  id         Int      @id @default(autoincrement())
  owner      String
  repo       String
  scannedAt  DateTime @default(now())

  total      Int
  vulnerable Int
  critical   Int
  high       Int
  medium     Int
  low        Int

  @@index([owner, repo, scannedAt])
}

model RepoAudit {
  id          Int      @id @default(autoincrement())
  owner       String
  repo        String
  checkedAt   DateTime @default(now())

  // GitHub Code Scanning (CodeQL / SAST)
  csTotal     Int @default(0)
  csCritical  Int @default(0)
  csHigh      Int @default(0)
  csMedium    Int @default(0)
  csLow       Int @default(0)

  // GitHub Dependabot
  dbTotal     Int @default(0)
  dbCritical  Int @default(0)
  dbHigh      Int @default(0)
  dbMedium    Int @default(0)
  dbLow       Int @default(0)

  // GitHub Secret Scanning
  ssTotal     Int @default(0)
  ssActive    Int @default(0)  // unresolved secrets

  alerts      String // JSON array of AuditAlert

  // État de chaque source : "ok" | "disabled" | "no-access" | "unknown" (audit antérieur à ces colonnes).
  // Une source désactivée n'est PAS « aucune alerte ».
  csState     String @default("unknown")
  dbState     String @default("unknown")
  ssState     String @default("unknown")

  @@unique([owner, repo])
}

model RepoPosture {
  id            Int      @id @default(autoincrement())
  owner         String
  repo          String
  checkedAt     DateTime @default(now())

  score         Int      // 0-100 sur les contrôles évaluables
  total         Int
  evaluated     Int
  passed        Int
  failed        Int
  warning       Int
  unknown       Int
  failCritical  Int
  failHigh      Int
  failMedium    Int
  failLow       Int

  isPrivate     Boolean
  defaultBranch String
  results       String   // JSON ControlResult[]

  @@unique([owner, repo])
}

model Domain {
  id          Int       @id @default(autoincrement())
  domain      String    @unique
  addedAt     DateTime  @default(now())
  checkedAt   DateTime?

  // HTTP
  httpStatus  Int?
  httpsRedirect Boolean?
  ipAddress   String?

  // SSL
  sslValid    Boolean?
  sslExpiry   DateTime?
  sslIssuer   String?
  sslDaysLeft Int?

  // Security headers
  hasHsts     Boolean?
  hasCsp      Boolean?
  hasXFrame   Boolean?
  hasXContent Boolean?
  hasRp       Boolean?   // Referrer-Policy

  // Analyse Sucuri SiteCheck (lancée à la demande) : JSON normalisé (SitecheckResult) et date.
  sucuri      String?
  sucuriAt    DateTime?
}

model UserPref {
  githubLogin String   @id
  selectedOrg String   @default("")
  updatedAt   DateTime @updatedAt
}

// État d'une alerte du Feed (ignorée, reportée, assignée). La clé est l'empreinte stable de l'alerte
// (voir src/lib/issues-core.ts). Une ligne par utilisateur GitHub : une base partagée (web) n'est pas mélangée.
model IssueState {
  githubLogin String
  key         String
  // "open" (simple assignation) | "ignored" | "snoozed"
  status      String   @default("open")
  // "false-positive" | "accepted-risk" | "not-used" | "mitigated" | "other"
  reason      String   @default("")
  note        String   @default("")
  until       DateTime?
  assignee    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([githubLogin, key])
  @@index([githubLogin, status])
}

// Analyse des secrets faite par Openkido (indépendante de GitHub Secret Scanning). Les valeurs ne sont jamais
// conservées : `findings` ne contient que des aperçus masqués et des empreintes.
model RepoSecrets {
  id           Int      @id @default(autoincrement())
  owner        String
  repo         String
  checkedAt    DateTime @default(now())

  // "complete" | "partial" (fichiers ignorés car trop volumineux ou archive tronquée)
  status       String   @default("complete")
  filesScanned Int
  filesSkipped Int
  total        Int
  critical     Int
  high         Int
  medium       Int
  low          Int
  findings     String   // JSON SecretFinding[]
  note         String?

  @@unique([owner, repo])
}

// Cache des licences déclarées par version de paquet (source : deps.dev). `license` = expression SPDX,
// ou "NONE" si le paquet ne déclare aucune licence.
model PackageLicense {
  ecosystem String
  name      String
  version   String
  license   String
  fetchedAt DateTime @default(now())

  @@id([ecosystem, name, version])
}

// Suivi des alertes dans le temps (cartes « Nouvelles » et « Résolues » du Feed). Une ligne par alerte et par
// utilisateur ; `baseline` marque le premier relevé, dont les alertes ne comptent pas comme nouvelles.
model IssueHistory {
  githubLogin String
  key         String
  kind        String
  severity    String
  target      String
  title       String
  firstSeen   DateTime
  resolvedAt  DateTime?
  baseline    Boolean  @default(false)

  @@id([githubLogin, key])
  @@index([githubLogin, resolvedAt])
}
