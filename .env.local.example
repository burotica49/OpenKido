# GitHub OAuth App
# Créer sur https://github.com/settings/developers → OAuth Apps
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# NextAuth secret (générer avec: openssl rand -base64 32)
AUTH_SECRET=your_random_secret_32_chars

# ── Instance web (Dokploy) — à renseigner impérativement ───────────────────────
# URL publique de l'instance (évite de déduire les callbacks des en-têtes Host)
# AUTH_URL=https://openkido.example.com
# Comptes GitHub autorisés à se connecter (séparés par des virgules).
# Laisser vide = n'importe quel compte GitHub peut se connecter. Les deux listes se cumulent.
# ALLOWED_GITHUB_LOGINS=votre-login,collegue
# ALLOWED_GITHUB_ORGS=votre-organisation
