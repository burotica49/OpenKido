{
	"name": "openkido",
	"version": "1.2.1",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"electron:compile": "tsc -p electron/tsconfig.json",
		"electron:dev": "npm run electron:compile && concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
		"electron:build": "npm run build && npm run electron:compile && npm run electron:template-db && electron-builder",
		"electron:build:mac": "npm run build && npm run electron:compile && npm run electron:template-db && electron-builder --mac",
		"electron:template-db": "rm -f build/template.db && DATABASE_URL=file:./build/template.db prisma migrate deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"demo:seed": "node --no-warnings scripts/seed-demo.ts",
		"demo:screenshots": "node scripts/demo-screenshots.mjs"
	},
	"dependencies": {
		"@auth/core": "^0.41.3",
		"@base-ui/react": "^1.6.0",
		"@libsql/client": "^0.17.4",
		"@octokit/rest": "^22.0.1",
		"@prisma/adapter-libsql": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@tabler/icons-react": "^3.44.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.22.0",
		"next": "16.4.2",
		"next-auth": "^5.0.0-beta.32",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^22.20.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"concurrently": "^10.0.3",
		"electron": "^43.8.3",
		"electron-builder": "^26.15.3",
		"eslint": "^9",
		"eslint-config-next": "16.4.2",
		"prisma": "^7.10.1",
		"shadcn": "^4.22.1",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.5",
		"wait-on": "^9.0.10"
	},
	"main": "dist/electron/main.js",
	"description": "Sécurité applicative pour développeurs — SCA, SAST, conformité",
	"author": {
		"name": "Burotica",
		"email": "a.roy@burotica.fr"
	},
	"overrides": {
		"deepmerge-ts": "^8.0.1"
	}
}
